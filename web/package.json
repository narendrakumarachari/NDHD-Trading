{
  "name": "ndhd-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "NDHD trading dashboard (TypeScript + React 18, compiled by tsc, no bundler).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
